# LOCAL DEV ONLY — on Databricks, secrets are resolved via the SDK.
# Copy to .env if you want to run the Flask app locally for debugging.
# Do NOT commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
NWS_USER_AGENT=weather-app (your-email@example.com)
